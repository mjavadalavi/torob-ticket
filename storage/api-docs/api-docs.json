                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "HTTP Bad Request",
                                        "code": "400",
                                        "data": "your request don't have some parameter."
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/weekly-schedule": {
            "post": {
                "tags": [
                    "weekly-schedule"
                ],
                "summary": "Add a new weekly schedule",
                "operationId": "addweeklyschedule",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "source_city_id": {
                                        "type": "string"
                                    },
                                    "source_terminal_id": {
                                        "type": "string"
                                    },
                                    "destination_city_id": {
                                        "type": "string"
                                    },
                                    "destination_terminal_id": {
                                        "type": "string"
                                    },
                                    "moving_day_number": {
                                        "type": "integer"
                                    },
                                    "moving_time_seconds": {
                                        "type": "integer"
                                    },
                                    "traveling_time": {
                                        "type": "string"
                                    },
                                    "capacity": {
                                        "type": "string"
                                    },
                                    "bus_type": {
                                        "type": "integer"
                                    },
                                    "price": {
                                        "type": "integer"
                                    }
                                },
                                "type": "object",
                                "example": {
                                    "source_city_id": "esf",
                                    "source_terminal_id": "5",
                                    "destination_city_id": "teh",
                                    "destination_terminal_id": "3",
                                    "moving_day_number": 0,
                                    "moving_time_seconds": 28800,
                                    "traveling_time": 240,
                                    "capacity": 26,
                                    "bus_type": 1,
                                    "price": 2000000
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "ok",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "id": "1",
                                        "source_city_id": "esf",
                                        "source_terminal_id": "5",
                                        "destination_city_id": "teh",
                                        "destination_terminal_id": "3",
                                        "moving_day_number": 0,
                                        "moving_time_seconds": 28800,
                                        "traveling_time": 240,
                                        "capacity": 26,
                                        "bus_type": 1,
                                        "price": 2000000
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "HTTP Bad Request",
                                        "code": "400",
                                        "data": "your request don't have some parameter."
                                    }
                                }
                            }
                        }
                    }
                }
            }
