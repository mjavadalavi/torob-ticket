    "paths": {
        "/StoreBuy": {
            "post": {
                "tags": [
                    "buy"
                ],
                "summary": "Store new Reserve",
                "description": "Returns json of result storing data",
                "operationId": "StoreBuyRequest",
                "parameters": [
                    {
                        "name": "search_hash",
                        "in": "path",
                        "description": "a hash id of searched by user",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "passenger_count",
                        "in": "path",
                        "description": "count of passengers",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "chairs",
                        "in": "path",
                        "description": "an array of chairs user needed .",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "App\\Http\\Requests\\StoreReserveRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "ticket_id": 1,
                                        "passenger": {
                                            "firstname": "mohammad",
                                            "lastname": "alaaasd",
                                            "national_code": "1180769036",
                                            "mobile": "09012356486"
                                        },
                                        "message": "your ticket successfully bought"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "HTTP Bad Request",
                                        "code": "400",
                                        "data": "your request don't have some parameter."
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/ExtraditionBuy": {
            "post": {
                "tags": [
                    "buy"
                ],
                "summary": "extradited a bougth",
                "description": "Returns json of result storing data",
                "operationId": "ExtraditionBuyRequest",
                "parameters": [
                    {
                        "name": "ticket_id",
                        "in": "path",
                        "description": "a id of ticket bougth by user",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "Success",
                                        "code": "1",
                                        "data": "your bougth successfully extradited"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "Failed",
                                        "code": "-1",
                                        "data": "ticket with this id not found"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "HTTP Bad Request",
                                        "code": "400",
                                        "data": "your request don't have some parameter."
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/index": {
            "get": {
                "tags": [
                    "weekly-schedule"
                ],
                "summary": "show list of source, destination or terminals ",
                "description": "Returns list of source, destination or terminals",
                "operationId": "getlistItems",
                "parameters": [
                    {
                        "name": "action",
                        "in": "path",
                        "description": "action of oprations each of ['terminal', 'destination', 'source']",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "destination",
                        "in": "path",
                        "description": "city destination short-code with max 5 char",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "source",
                        "in": "path",
                        "description": "source city short-code with max 5 char",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/reserve": {
            "post": {
                "tags": [
                    "reserve"
                ],
                "summary": "Store new Reserve",
                "description": "Returns json of result storing data",
                "operationId": "storeReserveRequest",
                "parameters": [
                    {
                        "name": "search_hash",
                        "in": "path",
                        "description": "a hash id of searched by user",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "passenger_count",
                        "in": "path",
                        "description": "count of passengers",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "chairs",
                        "in": "path",
                        "description": "an array of chairs user needed.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "example": {
                                    "search_hash": "s3w3rf",
                                    "passenger_count": "5",
                                    "chairs": "['0'=>1,'1'=>2,'2'=>3,'3'=>4]"
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "id": 1,
                                        "weekly_schedule_id": 3,
                                        "chair_id": 2,
                                        "passenger_count": 20,
                                        "chairs": "[1,2,3,4]",
                                        "status": 1
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "HTTP Bad Request",
                                        "code": "400",
                                        "data": "your request don't have some parameter."
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/Cancellation": {
            "post": {
                "tags": [
                    "reserve"
                ],
                "summary": "Cancel a Reserve",
                "description": "Returns json of result cancelling.",
                "operationId": "CancelReserveRequest",
                "parameters": [
                    {
                        "name": "reserve_id",
                        "in": "path",
                        "description": "an id of users reserved.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "Success",
                                        "code": "1",
                                        "data": "your reservations successfully cancelled"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "Failed",
                                        "code": "-1",
                                        "data": "ticket with this id not found"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "example": {
                                        "status": "HTTP Bad Request",
                                        "code": "400",
                                        "data": "your request don't have some parameter."
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/searches": {
            "get": {
                "tags": [
                    "search"
                ],
                "summary": "Get list of travells ",
                "description": "Returns json list of weekly schedule",
                "operationId": "searches",
                "parameters": [
                    {
                        "name": "date",
                        "in": "path",
                        "description": "date of bus",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "destination",
                        "in": "path",
                        "description": "city destination short-code with max 5 char",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "source",
                        "in": "path",
                        "description": "source city short-code with max 5 char",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "404": {
                        "description": "Not Found"
                    },
                    "400": {
                        "description": "Http Bad Request"
                    }
                }
            }
        },
        "/extraditionBuy": {
            "post": {
                "tags": [
                    "search"
                ],
                "summary": "extradited a bougth",
                "description": "Returns json of result storing data",
                "operationId": "extraditionBuyRequest",
                "parameters": [
                    {
                        "name": "action",
                        "in": "path",
                        "description": "action of oprations each of ['search', 'reserve', 'ticket']",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "ticket_id",
                        "in": "path",
                        "description": "a id of ticket bougth by user",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "reserve_id",
                        "in": "path",
                        "description": "a id of reservation by user",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "search_hash",
                        "in": "path",
                        "description": "a hash of searchs by user",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "checking",
                        "content": {
                            "application/json": {
