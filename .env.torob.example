# Shared local configuration for FastAPI + Next.js Torob Ticket.
TOROB_TRAVEL_PROJECT_NAME=Torob Ticket API
TOROB_TRAVEL_ENVIRONMENT=development
TOROB_TRAVEL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TOROB_TRAVEL_ADAPTER_TIMEOUT_SECONDS=8
# Keep autocomplete responsive even when one location provider is slow.
TOROB_TRAVEL_LOCATION_TIMEOUT_SECONDS=2
# Bound public search work before requests reach the provider connection pools.
TOROB_TRAVEL_SEARCH_MAX_CONCURRENCY=16
TOROB_TRAVEL_SEARCH_ADMISSION_TIMEOUT_SECONDS=0.1
# Re-rank a recent provider response without immediately crawling the OTA again.
TOROB_TRAVEL_ADAPTER_SEARCH_CACHE_TTL_SECONDS=30
TOROB_TRAVEL_ADAPTER_SEARCH_CACHE_MAX_ENTRIES=256
TOROB_TRAVEL_OFFER_TTL_SECONDS=900
TOROB_TRAVEL_OFFER_REPOSITORY_MAX_ENTRIES=5000
# The in-memory offer/context store requires exactly one API worker.
TOROB_TRAVEL_API_WORKERS=1
# Redirect hosts are bound to their own provider; never use a global shared allowlist.
TOROB_TRAVEL_REDIRECT_HOSTS_BY_PROVIDER=alibaba=www.alibaba.ir|alibaba.ir;flytoday=www.flytodayir.com|flytodayir.com;snapptrip=www.snapptrip.com|snapptrip.com;mrbilit=mrbilit.com|www.mrbilit.com;safar724=safar724.com|www.safar724.com;booking=www.booking.ir|booking.ir;payaneha=www.payaneha.com|payaneha.com
# Server-side Next.js proxy target. Browser requests remain same-origin.
API_URL=http://backend:8000/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=3000
